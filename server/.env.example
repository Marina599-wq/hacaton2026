PORT=5000
DATABASE_URL="file:./dev.db"
JWT_SECRET="your-super-secret-jwt-key-change-in-production"
JWT_EXPIRES_IN=24h
NODE_ENV="development"
# Список разрешённых CORS-origins через запятую (дефолт для разработки)
CORS_ORIGINS=http://localhost:5173
# Опорная дата прогноза демо (ТЗ-доработка WP-7 §9/§13) = последняя дата демо-выписки
# (statement-demo-C001.csv: 2026-09-29). После regeneration demo/ через pick-demo.mjs — обновить.
# Чтобы прогнозы «живых» выписок шли от текущей даты, закомментируйте строку.
FORECAST_AS_OF=2026-09-29